# ============================================================
# DENTAL CLINIC — Environment Variables
# Copy this file to .env.local and fill in your real values
# ============================================================

# ---- App ----
NEXT_PUBLIC_SITE_URL=https://yourclinic.com

# ---- Clinic Contact ----
NEXT_PUBLIC_CLINIC_PHONE=+20XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=+20XXXXXXXXXX

# ---- Google Maps ----
# Get your embed URL from: https://maps.google.com -> Share -> Embed a map
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://maps.google.com/maps?q=...&output=embed
NEXT_PUBLIC_GOOGLE_MAPS_DIRECTION_URL=https://maps.google.com/?q=...

# ---- Booking System ----
# Leave empty to use WhatsApp as the booking method
# Or set to your external booking system URL:
# NEXT_PUBLIC_BOOKING_URL=https://booking.yourclinic.com
NEXT_PUBLIC_BOOKING_URL=

# ---- Analytics ----
# Google Tag Manager is the only tag-loading layer (GA4 is configured
# inside the GTM container itself, not hardcoded on the site). Loaded
# only on public routes — never on /admin or /api. Leave empty to
# disable analytics entirely.
NEXT_PUBLIC_GTM_ID=GTM-K3Q6NQK7

# ---- Meta Pixel / Conversions API ----
# Pixel loads on public routes only. NEXT_PUBLIC_* is inlined at build
# time, so changing it requires a redeploy. Defaults to 1492302586121404.
NEXT_PUBLIC_META_PIXEL_ID=1492302586121404
# Server-side (Conversions API). Optional — if META_CAPI_TOKEN is empty,
# server-side Lead sending is skipped silently. Never commit the token.
META_PIXEL_ID=1492302586121404
META_CAPI_TOKEN=
# Set temporarily (e.g. TEST12345) to see server events in Events Manager → Test Events.
META_CAPI_TEST_EVENT_CODE=
